# Where images are served from.
#   local  (default) -> /public/media, populated by `npm run fetch:media`
#   legacy           -> https://telcobright.com/wp-content/uploads (for a quick
#                       preview before the media has been pulled down)
NEXT_PUBLIC_MEDIA_SOURCE=local

# Override the host `npm run fetch:media` pulls from.
# LEGACY_ORIGIN=https://telcobright.com

# --- Admin ---------------------------------------------------------------
# Signs the session cookie. Set this in production: without it a key is
# generated once and kept in data/auth-secret.json, which means every server
# in a cluster would sign with a different one. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=

# Where content, job posts, applications and uploads are stored.
# Defaults to ./data. Point it at a persistent disk in production, and back it
# up — CVs live here and exist nowhere else.
# DATA_DIR=/var/lib/telcobright/data
