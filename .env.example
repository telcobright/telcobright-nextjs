# Where images are served from.
#   local  (default) -> /public/media, populated by `npm run fetch:media`
#   legacy           -> https://telcobright.com/wp-content/uploads (for a quick
#                       preview before the media has been pulled down)
NEXT_PUBLIC_MEDIA_SOURCE=local

# Override the host `npm run fetch:media` pulls from.
# LEGACY_ORIGIN=https://telcobright.com
